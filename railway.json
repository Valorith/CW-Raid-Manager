{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": ["npm --workspace server run knex:migrate"]
  },
  "environments": {
    "pr": {
      "deploy": {
        "preDeployCommand": [
          "sh -c 'if [ \"$RAILWAY_SERVICE_NAME\" != \"CW-Nexus-Manager\" ]; then npm --workspace server run prisma:push-preview; fi'"
        ]
      }
    }
  }
}
